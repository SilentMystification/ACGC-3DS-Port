; gx.v.pica - GX vertex stage for the 3DS port (see 3ds/src/n3ds_tev.c).
; Position transform, GX channel-0 lighting per vertex, and two texgens
; routed to the three PICA texture units. Fog is done by the PICA fog unit.

.fvec proj[4], mv[3], nrm[3]
.fvec texmtx0[2], texmtx1[2]
.fvec tgsrc            ; x: texgen 0 reads the normal, y: texgen 1 (1 or 0)
.fvec unitsel[3]       ; per texture unit: x = weight of texgen 0, y = texgen 1
.fvec matReg, matSel   ; material = mix(matReg, vertex color, matSel)
.fvec ambReg, ambSel   ; ambient, same form; ambReg.w = alpha factor
.fvec unlitAcc         ; light sum when lighting is off: (1, 1, 1, alpha factor)
.fvec lightDir[8], lightCol[8]
.ivec lightLoop        ; (active lights - 1, 0, 1, 0)
.bool lit

.constf consts(0.0, 1.0, 0.00392156862745, 0.0)
.alias zeros consts.xxxx
.alias ones consts.yyyy
.alias inv255 consts.zzzz

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2

.alias inpos v0
.alias innrm v1
.alias inclr v2
.alias intc v3

.proc main
	; eye = mv * (pos, 1); clip = proj * eye
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 r1.x, mv[0], r0
	dp4 r1.y, mv[1], r0
	dp4 r1.z, mv[2], r0
	mov r1.w, ones
	dp4 outpos.x, proj[0], r1
	dp4 outpos.y, proj[1], r1
	dp4 outpos.z, proj[2], r1
	dp4 outpos.w, proj[3], r1

	; r2 = (normalize(nrm * n), 1)
	dp3 r2.x, nrm[0], innrm
	dp3 r2.y, nrm[1], innrm
	dp3 r2.z, nrm[2], innrm
	dp3 r3.x, r2, r2
	rsq r3.x, r3.x
	mul r2.xyz, r2, r3.xxx
	mov r2.w, ones

	; r4 = vertex color in [0, 1]
	mul r4, inv255, inclr

	; r6 = light sum
	ifu lit
		mov r6, ambReg
		add r7, r4, -r6
		mul r7, ambSel, r7
		add r6, r6, r7
		for lightLoop
			dp3 r7.x, lightDir[aL], r2
			max r7.x, zeros, r7.x
			mul r8, lightCol[aL], r7.xxxx
			add r6, r6, r8
		.end
		min r6, ones, r6
	.else
		mov r6, unlitAcc
	.end

	; color = material * light sum
	mov r5, matReg
	add r7, r4, -r5
	mul r7, matSel, r7
	add r5, r5, r7
	mul outclr, r5, r6

	; texgen inputs: (s, t, 0, 1) or (normal, 1)
	mov r9.xy, intc
	mov r9.z, zeros
	mov r9.w, ones
	add r10, r2, -r9
	mul r11, tgsrc.xxxx, r10
	add r11, r9, r11
	mul r12, tgsrc.yyyy, r10
	add r12, r9, r12
	dp4 r13.x, texmtx0[0], r11
	dp4 r13.y, texmtx0[1], r11
	dp4 r13.z, texmtx1[0], r12
	dp4 r13.w, texmtx1[1], r12

	; unit u texcoord = texgen0 * unitsel[u].x + texgen1 * unitsel[u].y
	mul r14, unitsel[0].xxyy, r13
	add outtc0.xy, r14.xy, r14.zw
	mul r14, unitsel[1].xxyy, r13
	add outtc1.xy, r14.xy, r14.zw
	mul r14, unitsel[2].xxyy, r13
	add outtc2.xy, r14.xy, r14.zw

	end
.end
