; test_out3.v.pica - GPU self-test B3a/b: 2 inputs (as test A), outputs position, color, texcoord0.
.constf consts(1.0, 0.00392156862745, 0.0, 0.0)
.alias ones consts.xxxx
.alias inv255 consts.yyyy

.out outpos position
.out outclr color
.out outtc0 texcoord0

.proc main
	mov outpos.xyz, v0
	mov outpos.w, ones
	mul outclr, inv255, v1
	mov outtc0, v0
	end
.end
